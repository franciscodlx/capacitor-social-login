{
  "name": "@franciscodlxdev/capacitor-tiktok-login",
  "version": "0.1.0",
  "description": "TikTok Login Kit (web flow) for Capacitor and Ionic in the system browser, code exchanged by your backend. No client secret in the app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!**/__tests__",
    "!**/__fixtures__"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "capacitor",
    "ionic",
    "tiktok",
    "tiktok-login",
    "login-kit",
    "oauth2",
    "social-login"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franciscodlx/capacitor-social-login.git",
    "directory": "packages/tiktok-login"
  },
  "author": "Francisco (https://github.com/franciscodlx)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/franciscodlx/capacitor-social-login/issues"
  },
  "homepage": "https://github.com/franciscodlx/capacitor-social-login/tree/main/packages/tiktok-login#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@franciscodlxdev/capacitor-auth-core": "^0.1.0"
  },
  "devDependencies": {
    "@franciscodlxdev/capacitor-auth-core": "workspace:*"
  }
}
